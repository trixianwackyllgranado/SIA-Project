# Copy this file to ".env" (same folder as main.py) and fill in your own values.
# .env is gitignored. Never commit it or paste these values anywhere public.

# ---- Email (Gmail SMTP) ----
# SMTP_USER is your Gmail address. SMTP_APP_PASSWORD is a 16-character App Password
# from your Google Account (Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# ---- SMS (TextBee) ----
# From the TextBee dashboard after you link your Android phone.
TEXTBEE_API_KEY=
# Optional: leave empty to use your default device.
TEXTBEE_DEVICE_ID=
